#!/bin/sh
# Run the test suite before pushing, the same way CI does. Uses Docker because
# the Go 1.22 linker on this Mac cannot run test binaries (missing LC_UUID).
# Skip once with: git push --no-verify
set -e
if ! docker info >/dev/null 2>&1; then
  echo "pre-push: Docker is not running, tests skipped (CI will still run them)"; exit 0
fi
root=$(git rev-parse --show-toplevel)
docker run --rm -v "$root":/src -w /src -v sm-gomod:/go/pkg/mod golang:1.26.10 \
  sh -c 'go vet ./... && go test -count=1 ./...'
